# データベース
DATABASE_URL=sqlite:///./app.db

# JWT設定
SECRET_KEY=your-secret-key-here-for-testing-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI設定
OPENAI_API_KEY=sk-dummy-key-for-testing
OPENAI_MODEL=gpt-3.5-turbo

# Microsoft Graph設定
MICROSOFT_CLIENT_ID=dummy-client-id
MICROSOFT_CLIENT_SECRET=dummy-client-secret
MICROSOFT_TENANT_ID=dummy-tenant-id

# ログ設定
LOG_LEVEL=INFO
LOG_FILE=app.log
