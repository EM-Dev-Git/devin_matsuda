# データベース
DATABASE_URL=sqlite:///./app.db

# JWT設定
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# ログ設定
LOG_LEVEL=INFO
LOG_FILE=app.log

# アプリケーション設定
APP_NAME=Transcript to Minutes API
APP_VERSION=1.0.0
DEBUG=False
